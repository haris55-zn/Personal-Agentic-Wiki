# Salin file ini menjadi `.env`, lalu isi nilai sebenarnya.
# `.env` TIDAK di-commit ke git (lihat .gitignore).

# ── LLM (OpenAI-compatible; kosong = default provider) ──
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-pro

# ── Embedding multibahasa (dijalankan lokal) ──
EMBEDDING_MODEL=BAAI/bge-m3

# ── Penyimpanan (opsional; default SQLite di backend/data/) ──
# SQLite bawaan otomatis. Untuk Postgres, setel:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
# DATABASE_URL=
# CHROMA_PATH=